DATABASE_URL="postgresql://parking:parking@localhost:5433/smart_parking?schema=public"
REDIS_URL="redis://localhost:6379"
# NDRYSHO këto në prodhim — vlera të rastësishme e të forta (p.sh. `openssl rand -base64 48`)
JWT_ACCESS_SECRET="changeme_access"
JWT_REFRESH_SECRET="changeme_refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
SENSOR_SIMULATOR_ENABLED=true
SENSOR_SIMULATOR_INTERVAL_MS=8000
# Domain(-e) i frontend-it të deployuar, i ndarë me presje nëse janë disa
# (p.sh. domain prodhimi + preview URLs) — bosh/e paracaktuar = CORS lejon çdo
# origjinë (mirë vetëm për dev lokal, JO për prodhim). E para në listë
# përdoret edhe si destinacion i redirect-it pas Google OAuth (fallback
# http://localhost:3000 nëse bosh).
FRONTEND_URL=
# Google Cloud Console → APIs & Services → Credentials → OAuth Client ID
# (Web application). Redirect URI i autorizuar duhet të përputhet saktësisht
# me GOOGLE_CALLBACK_URL (default http://localhost:3001/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# Resend (https://resend.com) — për email-verifikim + rivendosje fjalëkalimi.
# Pa këtë, backend-i vetëm regjistron email-et në log (s'dështon asgjë,
# thjesht s'dërgohen realisht) — mirë për dev lokal pa llogari Resend ende.
RESEND_API_KEY=
# "onboarding@resend.dev" funksionon pa domain të verifikuar (vetëm testim);
# në prodhim duhet një domain i verifikuar te Resend.
EMAIL_FROM="Smart Parking Prizren <onboarding@resend.dev>"
