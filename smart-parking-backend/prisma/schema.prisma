generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Role {
  citizen
  attendant
  admin
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  // Opsionale që kur u shtua Google OAuth (Faza 14.3) — një user i krijuar
  // vetëm përmes Google s'ka fjalëkalim lokal; login-i klasik e kontrollon
  // shprehimisht rastin null (shih AuthService.login).
  passwordHash       String?
  // Vetëm për user-a që janë kyçur të paktën një herë me Google — lidhje
  // (jo zëvendësim) me llogarinë ekzistuese kur email-i përputhet.
  googleId           String?          @unique
  role               Role             @default(citizen)
  hashedRefreshToken String?
  // Faza redesign (2026-08-30+): user-at e krijuar via Google janë verifikuar
  // tashmë nga Google (emailVerified=true në krijim, shih AuthService); user-at
  // lokalë fillojnë false dhe verifikohen përmes lidhjes së dërguar me Resend.
  emailVerified               Boolean   @default(false)
  emailVerificationTokenHash  String?
  emailVerificationExpiresAt  DateTime?
  passwordResetTokenHash      String?
  passwordResetExpiresAt      DateTime?
  sessions           ParkingSession[]
  reservations       Reservation[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([emailVerificationTokenHash])
  @@index([passwordResetTokenHash])
  @@map("users")
}

enum SpotStatus {
  free
  occupied
  reserved
  disabled
}

// `polygon` mbahet si Unsupported: Prisma Client s'i hidraton dot tipet
// gjeometrike PostGIS nativisht — leximi/shkrimi bëhet me SQL raw
// (ST_AsGeoJSON / ST_GeomFromGeoJSON) te ZonesService.
model ParkingZone {
  id        String                                 @id @default(uuid())
  name      String
  polygon   Unsupported("geometry(Polygon, 4326)")
  spots     ParkingSpot[]
  createdAt DateTime                               @default(now())
  updatedAt DateTime                               @updatedAt

  @@map("parking_zones")
}

model ParkingSpot {
  id           String                               @id @default(uuid())
  code         String
  location     Unsupported("geometry(Point, 4326)")
  status       SpotStatus                           @default(free)
  zoneId       String
  zone         ParkingZone                          @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  sensorEvents SensorEvent[]
  sessions     ParkingSession[]
  reservations Reservation[]
  createdAt    DateTime                             @default(now())
  updatedAt    DateTime                             @updatedAt

  @@unique([zoneId, code])
  @@index([zoneId])
  @@map("parking_spots")
}

// Regjistër i leximeve të simuluara nga "sensor simulator"-i (Faza 3) —
// bazë për analitikën e avancuar (heatmap/orët e pikut) në Fazën 9.
model SensorEvent {
  id        String      @id @default(uuid())
  spotId    String
  spot      ParkingSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  status    SpotStatus
  timestamp DateTime    @default(now())

  @@index([spotId])
  @@map("sensor_events")
}

enum SessionSource {
  sensor
  manual
  qr
}

// `userId` opsional: sesionet e krijuara nga "sensor simulator"-i (jo ende
// të lidhura, shih CLAUDE.md §4/§8) do të ishin anonime; check-in/check-out
// manual (Faza 4) gjithmonë e vendos userId, pasi kërkon qytetar të kyçur.
model ParkingSession {
  id        String        @id @default(uuid())
  spotId    String
  spot      ParkingSpot   @relation(fields: [spotId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  checkIn   DateTime      @default(now())
  checkOut  DateTime?
  source    SessionSource
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([spotId])
  @@index([userId])
  @@map("parking_sessions")
}

enum ReservationStatus {
  confirmed
  cancelled
}

// Rezervimi s'e ndryshon vetë `ParkingSpot.status` (ai pasqyron gjendjen
// FIZIKE aktuale nga sensori/check-in, jo prenotime të ardhshme) — lidhja e
// vetme me kohën reale është te SessionsService.checkIn, që refuzon
// check-in nëse spoti ka rezervim aktiv (tani) të një përdoruesi tjetër.
model Reservation {
  id           String            @id @default(uuid())
  spotId       String
  spot         ParkingSpot       @relation(fields: [spotId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime    DateTime
  endTime      DateTime
  status       ReservationStatus @default(confirmed)
  // E vendos NotificationsService.checkReminders (Faza 7) kur dërgon
  // kujtesën "fillon së shpejti" — mbron nga dërgimi i përsëritur.
  reminderSent Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([spotId])
  @@index([userId])
  @@map("reservations")
}

enum NotificationType {
  checkin
  checkout
  reservation_confirmed
  reservation_cancelled
  reservation_reminder
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@map("notifications")
}

// Regjistron veprime të ndjeshme (hyrje/regjistrim, CRUD admin mbi
// zona/spote) për llogaridhënie dhe monitorim sigurie (Faza 8). `actorId`
// opsional: hyrjet e dështuara s'kanë përdorues të vërtetuar ende — email-i
// i provuar ruhet te `metadata` në atë rast. `metadata` mban kontekst fleksibël
// (p.sh. { zoneId, name }) pa shumëzuar kolona nullable për çdo lloj veprimi.
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}
