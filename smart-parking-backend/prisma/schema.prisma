generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// Modelet (ParkingSession, Reservation, Notification, AuditLog) shtohen
// fazë pas faze — shih CLAUDE.md, seksioni "Roadmap".

enum Role {
  citizen
  attendant
  admin
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  role               Role     @default(citizen)
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("users")
}

enum SpotStatus {
  free
  occupied
  reserved
  disabled
}

// `polygon` mbahet si Unsupported: Prisma Client s'i hidraton dot tipet
// gjeometrike PostGIS nativisht — leximi/shkrimi bëhet me SQL raw
// (ST_AsGeoJSON / ST_GeomFromGeoJSON) te ZonesService.
model ParkingZone {
  id        String                                 @id @default(uuid())
  name      String
  polygon   Unsupported("geometry(Polygon, 4326)")
  spots     ParkingSpot[]
  createdAt DateTime                               @default(now())
  updatedAt DateTime                               @updatedAt

  @@map("parking_zones")
}

model ParkingSpot {
  id           String                               @id @default(uuid())
  code         String
  location     Unsupported("geometry(Point, 4326)")
  status       SpotStatus                           @default(free)
  zoneId       String
  zone         ParkingZone                          @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  sensorEvents SensorEvent[]
  createdAt    DateTime                             @default(now())
  updatedAt    DateTime                             @updatedAt

  @@unique([zoneId, code])
  @@index([zoneId])
  @@map("parking_spots")
}

// Regjistër i leximeve të simuluara nga "sensor simulator"-i (Faza 3) —
// bazë për analitikën e avancuar (heatmap/orët e pikut) në Fazën 9.
model SensorEvent {
  id        String      @id @default(uuid())
  spotId    String
  spot      ParkingSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  status    SpotStatus
  timestamp DateTime    @default(now())

  @@index([spotId])
  @@map("sensor_events")
}
